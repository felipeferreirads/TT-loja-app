# Exemplo público de variáveis de ambiente. Copie para `.env` (ignorado pelo Git)
# e preencha com os valores reais. NUNCA versione o `.env` com chaves de verdade.

# Mesmo projeto Supabase do Tesouros da Terra (catálogo pessoal) — tabelas
# próprias do domínio comercial (store_products, store_sales...), mesmo padrão
# de auth/RLS por owner_id. Ver ../docs/PROJETO-APP-LOJA.md no repo do catálogo.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
